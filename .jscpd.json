{
  "threshold": 0,
  "minLines": 10,
  "minTokens": 80,
  "reporters": [
    "console"
  ],
  "ignorePattern": [
    "**/node_modules/**",
    "**/.git/**",
    "**/.claude/worktrees/**",
    "**/dist/**",
    "**/coverage/**",
    "**/src/generated/**",
    "**/*.md",
    "**/*.json",
    "**/*.lock"
  ]
}
