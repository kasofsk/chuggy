{
  "runner": "Agent",
  "purpose": "Review",
  "reevaluate": "OnChange",
  "prompt": { "path": ".chug/tasks/review-change.md" },
  "worker": {
    "mode": {
      "type": "SingleAgent",
      "agent": "Claude",
      "arguments": ["--allowedTools=Bash,Edit,Read,Write,Glob,Grep", "--model=opus"]
    },
    "setup": ["npm ci"],
    "files": []
  },
  "authority": {
    "tools": ["claude-code", "shell"],
    "credentials": ["claude-code", "track-record"],
    "network": true,
    "filesystem": "WriteWorkspace",
    "mayCompleteTask": false
  }
}
