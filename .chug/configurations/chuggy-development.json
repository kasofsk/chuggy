      "build-orchestrated": {
        "runner": "Agent",
        "prompt": {
          "path": ".chug/prompts/work-orchestrated.md"
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": [
              "--allowedTools=Bash,Edit,Read,Write,Glob,Grep",
              "--model=opus"
            ]
          },
          "setup": [
            "npm ci"
          ],
          "files": []
        },
        "authority": {
          "tools": [
            "claude-code",
            "shell"
          ],
          "credentials": [
            "chuggy-github-worker",
            "claude-code",
            "track-record"
          ],
          "network": true,
          "filesystem": "WriteWorkspace",
          "mayCompleteTask": false
        }
      },
      "ci": ".chug/workloads/ci.json",
      "review": ".chug/workloads/review.json"
    },
    "plans": {
      "standard": [
        {
          "name": "checks",
          "evaluators": [
            "ci"
          ]
        },
        {
          "name": "review",
          "evaluators": [
            "review"
          ]
        }
      ]
    },
    "defaults": {
      "work": "build",
      "evaluation": "standard"
    }
  }
