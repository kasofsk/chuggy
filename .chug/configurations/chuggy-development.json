{
  "version": 1,
  "name": "chuggy-development",
  "configuration": {
    "version": 2,
    "image": "registry.chuggy.internal/chuggy/worker@sha256:6d8fbbb3bfe5990cddf17feee08593b45452b44173a95e125df3a5e40820dd13",
    "workloads": {
      "build": {
        "runner": "Agent",
        "prompt": {
          "path": ".chug/prompts/work.md"
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": [
              "--allowedTools=Bash,Edit,Read,Write,Glob,Grep",
              "--model=opus"
            ]
          },
          "setup": [
            "npm ci"
          ],
          "files": []
        },
        "authority": {
          "tools": [
            "claude-code",
            "shell"
          ],
          "credentials": [
            "chuggy-github-worker",
            "claude-code",
            "track-record"
          ],
          "network": true,
          "filesystem": "WriteWorkspace",
          "mayCompleteTask": false
        }
      },
      "build-fable": {
        "runner": "Agent",
        "prompt": {
          "path": ".chug/prompts/work.md"
        },
        "worker": {
          "mode": {
