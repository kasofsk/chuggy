{
  "version": 1,
  "name": "basic-coding",
  "configuration": {
    "version": 2,
    "image": "worker:v1",
    "workloads": {
      "build": {
        "runner": "Agent",
        "prompt": {
          "text": "Implement the change this ticket asks for, and nothing else on it. Follow the repository's checked-in agent instructions, add focused regression coverage, and run the checks relevant to the files you changed. Do not perform destructive operations without approval. Report a pass only for work you have verified running, or a failure naming what stopped you."
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": [
              "--allowedTools=Bash,Edit,Read,Write,Glob,Grep"
            ]
          },
          "setup": [
            "npm ci"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "claude-code"
          ]
        }
      },
      "ci": {
        "runner": "Commands",
        "commands": [
          ".chug/tasks/ci.sh"
        ],
        "worker": {
          "setup": [
            "npm ci"
          ],
          "files": []
        },
        "authority": {
          "credentials": []
        }
      },
      "review": {
        "runner": "Agent",
        "purpose": "Review",
        "prompt": {
          "path": ".chug/tasks/review-change.md"
        },
        "worker": {
          "mode": {
            "type": "SingleAgent",
            "agent": "Claude",
            "arguments": [
              "--allowedTools=Bash,Edit,Read,Write,Glob,Grep"
            ]
          },
          "setup": [
            "npm ci"
          ],
          "files": []
        },
        "authority": {
          "credentials": [
            "claude-code"
          ]
        }
      }
    },
    "plans": {
      "standard": [
        {
          "name": "checks",
          "evaluators": [
            "ci"
          ]
        },
        {
          "name": "review",
          "evaluators": [
            "review"
          ]
        }
      ]
    },
    "defaults": {
      "work": "build",
      "evaluation": "standard"
    }
  }
}
