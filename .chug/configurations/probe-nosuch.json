{
  "version": 1,
  "name": "probe-nosuch",
  "configuration": {
    "version": 1,
    "image": "nosuch.example/x@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    "authority": {
      "tools": [
        "claude-code",
        "shell"
      ],
      "credentials": [
        "chuggy-github-worker",
        "claude-code"
      ],
      "network": true,
      "filesystem": "WriteWorkspace",
      "mayCompleteTask": false
    },
    "worker": {
      "mode": {
        "type": "SingleAgent",
        "agent": "Claude",
        "arguments": [
          "--allowedTools=Bash,Read,Glob,Grep",
          "--model=sonnet"
        ]
      },
      "setup": [],
      "files": []
    },
    "brief": {
      "motivation": [
        "Prove that an unlisted image that cannot be pulled blocks with ImageUnpullable rather than a policy denial."
      ],
      "acceptanceCriteria": [
        "The report states the facts the ticket asks for, and the repository is unchanged."
      ],
      "constraints": [
        "Change nothing in the repository and commit nothing."
      ]
    },
    "practices": [
      "AcceptanceCriteria"
    ],
    "work": {
      "instructions": [
        "Answer the ticket's questions by running commands, change nothing, and report what they printed."
      ]
    },
    "review": {
      "instructions": [
        "Confirm the work changed nothing and that its report answers what the ticket asked."
      ]
    },
    "evaluations": [
      {
        "purpose": "Check",
        "checks": [
          "git --version",
          "node --version",
          "test -z \"$(git status --porcelain)\""
        ]
      },
      {
        "purpose": "Review",
        "instructions": [
          "Confirm the work changed nothing and that its report answers what the ticket asked."
        ],
        "practices": [
          "AcceptanceCriteria"
        ]
      }
    ]
  }
}
