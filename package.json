{
  "name": "chuggy",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@informalsystems/quint": "0.32.0",
    "@ts-safeql/eslint-plugin": "^5.4.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "1.26.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "jscpd": "5.0.5",
    "libpg-query": "^17.7.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "type": "module",
  "workspaces": [
    "test/rig",
    "ui/chuggy-ui"
  ],
  "scripts": {
    "check": "./.chug/tasks/ci.sh",
    "migrate": "node --experimental-strip-types src/roots/migrate.ts",
    "start:finalizer": "node --experimental-strip-types src/roots/finalizer.ts",
    "start:native-web": "node --experimental-strip-types src/roots/nativeHttp.ts",
    "start:scheduler": "node --experimental-strip-types src/roots/scheduler.ts",
    "start:ticket-service": "node --experimental-strip-types src/roots/ticketService.ts",
    "start:worker-plane": "node --experimental-strip-types src/roots/workerPlane.ts",
    "start:ticket-worker": "node --experimental-strip-types src/roots/ticketWorker.ts",
    "provision:forge-installation": "node --experimental-strip-types src/roots/provisionForgeInstallation.ts",
    "provision:project-access": "node --experimental-strip-types src/roots/provisionProjectAccess.ts",
    "provision:session": "node --experimental-strip-types src/roots/provisionAgentSession.ts",
    "bind:project-repository": "node --experimental-strip-types src/roots/bindProjectRepository.ts"
  },
  "dependencies": {
    "@cursorless/tree-sitter-wasms": "0.10.0",
    "@ts-safeql/sql-tag": "^0.2.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "jsonc-parser": "3.3.1",
    "pg": "^8.23.0",
    "prismjs": "1.30.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
