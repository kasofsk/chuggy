# Both forms deliberately. The trailing-slash form matches a directory only, so
# a *symlink* named node_modules walks straight past it — which is exactly how
# one got committed into a sibling repo, pointing at an absolute path on one
# machine and dangling on every other clone.
node_modules
node_modules/

dist/
coverage/
.DS_Store

# The entrypoint's default journal and its WAL siblings, written where the
# process runs; a deployment names its own path instead.
chuggy.sqlite*
