# Both forms deliberately. The trailing-slash form matches a directory only, so
# a *symlink* named node_modules walks straight past it — which is exactly how
# one got committed into a sibling repo, pointing at an absolute path on one
# machine and dangling on every other clone.
node_modules
node_modules/

dist/
coverage/
.claude/worktrees/*
.DS_Store

# What a merge tool leaves behind. `check-source.sh`'s residue stage refuses one
# that is already tracked; these three lines are what stops `git add` staging a
# fresh one, and a file already tracked is unaffected by either — which is why
# there is a gate as well as this.
*.orig
*.rej
*.bak
