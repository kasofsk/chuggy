              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "branch": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^refs\\/heads\\/.*"
            },
            "finalization": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "Push"
                    },
                    "target": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^refs\\/heads\\/.*"
                    }
                  },
                  "required": ["mode"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
