{
  "version": 1,
  "basePath": "/api/v1",
  "mediaType": "application/vnd.chuggy.v1+json",
  "authentication": {
    "scheme": "Bearer",
    "formats": ["OIDC JWT", "session bearer"],
    "principal": "length-prefixed issuer and subject",
    "session": "a session bearer authorizes as the session's principal and is recorded on the operation"
  },
  "caching": "no-store",
  "cors": "same-origin",
  "credentials": "authorization bearer header; no cookies",
  "identities": {
    "installation": "canonical UUID authority identity",
    "tenant": "percent-encoded opaque UTF-8 path segment",
    "project": "percent-encoded opaque UTF-8 path segment",
    "cursor": "opaque canonical base64url"
  },
  "forgeInstallations": "a tenant's administrator claims an installation of this deployment's app; an installation another tenant holds is a conflict, and a claim is never released",
  "repositoryBinding": "binding a repository to a project creates no project: a project that does not exist is not found, and the repository must be one this deployment holds a credential for — on a host it mints for, that means an installation this tenant has claimed",
  "repositoryLanding": "a repository's landing default is written against the value the writer read",
  "repositoryRetirement": "a retired repository stays bound and stays readable by name, and stops being the one a session is placed against, the importer reads or a brief may name; this route only retires and repeating it changes nothing, and binding the repository again reinstates it",
  "repositoryCreation": "creating a repository requires this tenant's claims of both apps on the account; the repository is the forge's from the moment it answers, so a later refusal is reported beside one that stands and a name already taken is bound rather than created",
  "routes": {
    "contract": "/api/v1/contract",
    "installation": "/api/v1/installation",
    "forgeApps": "/api/v1/forge/github",
    "forgeInstallations": "/api/v1/tenants/:tenant/forge-installations",
    "forgeInstallationRepositories": "/api/v1/tenants/:tenant/forge-installations/:installationId/repositories",
    "projects": "/api/v1/projects",
    "project": "/api/v1/tenants/:tenant/projects/:project",
    "events": "/api/v1/tenants/:tenant/projects/:project/events",
    "lead": "/api/v1/tenants/:tenant/projects/:project/lead",
    "leadTranscript": "/api/v1/tenants/:tenant/projects/:project/lead/transcript",
    "leadInquiries": "/api/v1/tenants/:tenant/projects/:project/lead/inquiries",
    "leadInquiry": "/api/v1/tenants/:tenant/projects/:project/lead/inquiries/:session",
    "forgeCredentials": "/api/v1/tenants/:tenant/projects/:project/forge-credentials",
    "projectRepositories": "/api/v1/tenants/:tenant/projects/:project/repositories",
    "projectRepositoriesNew": "/api/v1/tenants/:tenant/projects/:project/repositories/new",
    "projectRepositoryLanding": "/api/v1/tenants/:tenant/projects/:project/repositories/landing",
    "projectRepositoryRetirement": "/api/v1/tenants/:tenant/projects/:project/repositories/retirement",
    "projectRepositoryDeclarations": "/api/v1/tenants/:tenant/projects/:project/repositories/declarations",
    "threads": "/api/v1/tenants/:tenant/projects/:project/threads",
    "thread": "/api/v1/tenants/:tenant/projects/:project/threads/:session",
    "threadTranscript": "/api/v1/tenants/:tenant/projects/:project/threads/:session/transcript",
    "threadMessages": "/api/v1/tenants/:tenant/projects/:project/threads/:session/messages",
    "threadClose": "/api/v1/tenants/:tenant/projects/:project/threads/:session/close",
    "threadRename": "/api/v1/tenants/:tenant/projects/:project/threads/:session/rename",
    "threadHide": "/api/v1/tenants/:tenant/projects/:project/threads/:session/hide",
    "ticketMachineAdmission": "/api/v1/tenants/:tenant/projects/:project/ticket-machine",
    "tickets": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/tickets",
    "ticket": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/tickets/:ticket",
    "ticketValidation": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/tickets/validate",
    "ticketCatalog": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/catalog",
    "ticketOperation": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/operations",
    "ticketOperations": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/operations/recent",
    "ticketExecutions": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/executions",
    "ticketExecution": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/executions/:task",
    "ticketExecutionTurns": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/executions/:task/attempts/:attempt/turns",
    "ticketExecutionTranscript": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/executions/:task/attempts/:attempt/transcript",
    "ticketExecutionConfiguration": "/api/v1/tenants/:tenant/projects/:project/ticket-machine/executions/:task/attempts/:attempt/configuration"
  },
  "schemas": {
    "forgeCredential": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "string",
          "enum": ["read", "write", "propose"]
        }
      },
      "required": ["repository", "permissions"],
      "additionalProperties": false
    },
    "forgeInstallationClaim": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "forge": {
          "type": "string",
          "enum": ["github"]
        },
        "app": {
          "type": "string",
          "enum": ["portal", "worker"]
        },
        "installationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["forge", "app", "installationId"],
      "additionalProperties": false
    },
    "projectRepositoryBind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "projectRepositoryCreate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "public"]
        }
      },
      "required": ["account", "name", "visibility"],
      "additionalProperties": false
    },
    "projectRepositoryLanding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["Push", "PullRequest", "PullRequestMerge"]
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        "landing": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["Push", "PullRequest", "PullRequestMerge"]
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      },
      "required": ["repository", "expected", "landing"],
      "additionalProperties": false
    },
    "projectRepositoryRetirement": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["repository"],
      "additionalProperties": false
    },
    "leadInquiry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["session", "turn", "question"],
      "additionalProperties": false
    },
    "threadMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": ["turn", "message"],
      "additionalProperties": false
    },
    "threadRename": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "threadHide": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "hidden": {
          "type": "boolean"
        }
      },
      "required": ["hidden"],
      "additionalProperties": false
    }
  }
}
