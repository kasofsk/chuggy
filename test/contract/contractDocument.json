                }
              },
              "required": ["type", "value"],
              "additionalProperties": false
            },
            "finalizationPricing": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "DeadlineOnly"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "Budgeted"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["type", "value"],
