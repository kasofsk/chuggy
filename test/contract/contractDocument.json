{
  "version": 1,
  "basePath": "/api/v1",
  "mediaType": "application/vnd.chuggy.v1+json",
  "authentication": {
    "scheme": "Bearer",
    "formats": ["OIDC JWT", "session bearer"],
    "principal": "length-prefixed issuer and subject",
    "session": "a session bearer authorizes as the session's principal and is recorded on the operation"
  },
  "notifications": "bounded-polling",
  "events": "sse",
  "caching": "no-store",
  "cors": "same-origin",
  "credentials": "authorization bearer header; no cookies",
  "ticketPhaseFilter": {
    "query": "phase",
    "all": "omit phase",
    "nonTerminal": "phase=NonTerminal",
    "selected": "repeat phase with one or more exact phase names"
  },
  "identities": {
    "installation": "canonical UUID authority identity",
    "tenant": "percent-encoded opaque UTF-8 path segment",
    "project": "percent-encoded opaque UTF-8 path segment",
    "ticket": "canonical positive decimal integer",
    "operation": "percent-encoded opaque UTF-8 path segment",
    "cursor": "opaque canonical base64url"
  },
  "executionOrder": {
    "order": "ticket then task, ascending",
    "cursor": "a position in that order; the ticket filter narrows it",
    "mismatch": "a cursor resuming an unselected ticket is refused"
  },
  "briefFinalization": "a PullRequest finalization requires the brief to name a branch, and a target that is not it",
  "selectorProjectSettings": "installation settings are defaults; an absent override inherits one, and a write replaces the whole set under the revision it was read at",
  "forgeInstallations": "a tenant's administrator claims an installation of this deployment's app; an installation another tenant holds is a conflict, and a claim is never released",
  "repositoryBinding": "binding a repository to a project creates no project: a project that does not exist is not found, and the repository must be one this deployment holds a credential for — on a host it mints for, that means an installation this tenant has claimed",
  "repositoryLanding": "a repository's landing default is the mode a ticket in it lands by unless its brief names one; it is written against the value the writer read, and a ticket authored with no finalizer may name no landing",
  "repositoryConfigurations": "a newly bound repository is imported at its own default-branch head, and one declaring no configurations is authored a bootstrap; the step is reported beside the binding and never refuses it",
  "repositoryCreation": "creating a repository requires this tenant's claims of both apps on the account; the repository is the forge's from the moment it answers, so a later refusal is reported beside one that stands and a name already taken is bound rather than created",
  "routes": {
    "contract": "/api/v1/contract",
    "installation": "/api/v1/installation",
    "forgeApps": "/api/v1/forge/github",
    "forgeInstallations": "/api/v1/tenants/:tenant/forge-installations",
    "forgeInstallationRepositories": "/api/v1/tenants/:tenant/forge-installations/:installationId/repositories",
    "projects": "/api/v1/projects",
    "project": "/api/v1/tenants/:tenant/projects/:project",
    "tickets": "/api/v1/tenants/:tenant/projects/:project/tickets",
    "ticket": "/api/v1/tenants/:tenant/projects/:project/tickets/:ticket",
    "ticketNativeActions": "/api/v1/tenants/:tenant/projects/:project/tickets/:ticket/native-actions",
    "ticketAgenticRefusals": "/api/v1/tenants/:tenant/projects/:project/tickets/:ticket/agentic-refusals",
    "nativeActions": "/api/v1/tenants/:tenant/projects/:project/native-actions",
    "agenticRefusals": "/api/v1/tenants/:tenant/projects/:project/agentic-refusals",
    "operationalStatus": "/api/v1/tenants/:tenant/projects/:project/operational-status",
    "selectorContext": "/api/v1/tenants/:tenant/projects/:project/selector-context",
    "selectorSettings": "/api/v1/tenants/:tenant/projects/:project/selector-settings",
    "selectorSettingsHistory": "/api/v1/tenants/:tenant/projects/:project/selector-settings/history",
    "selectorHistory": "/api/v1/tenants/:tenant/projects/:project/selector-history",
    "lead": "/api/v1/tenants/:tenant/projects/:project/lead",
    "leadTranscript": "/api/v1/tenants/:tenant/projects/:project/lead/transcript",
    "leadInquiries": "/api/v1/tenants/:tenant/projects/:project/lead/inquiries",
    "leadInquiry": "/api/v1/tenants/:tenant/projects/:project/lead/inquiries/:session",
    "executions": "/api/v1/tenants/:tenant/projects/:project/executions",
    "execution": "/api/v1/tenants/:tenant/projects/:project/executions/:execution",
    "outputContent": "/api/v1/tenants/:tenant/projects/:project/executions/:execution/artifacts/:ordinal",
    "runTurns": "/api/v1/tenants/:tenant/projects/:project/executions/:execution/attempts/:attempt/turns",
    "runTranscript": "/api/v1/tenants/:tenant/projects/:project/executions/:execution/attempts/:attempt/transcript",
    "runConfiguration": "/api/v1/tenants/:tenant/projects/:project/executions/:execution/attempts/:attempt/configuration",
    "operations": "/api/v1/tenants/:tenant/projects/:project/operations",
    "operation": "/api/v1/tenants/:tenant/projects/:project/operations/:operation",
    "notifications": "/api/v1/tenants/:tenant/projects/:project/notifications",
    "events": "/api/v1/tenants/:tenant/projects/:project/events",
    "configurations": "/api/v1/tenants/:tenant/projects/:project/configurations",
    "configurationImports": "/api/v1/tenants/:tenant/projects/:project/configurations/imports",
    "configuration": "/api/v1/tenants/:tenant/projects/:project/configurations/:revision",
    "forgeCredentials": "/api/v1/tenants/:tenant/projects/:project/forge-credentials",
    "projectRepositories": "/api/v1/tenants/:tenant/projects/:project/repositories",
    "projectRepositoriesNew": "/api/v1/tenants/:tenant/projects/:project/repositories/new",
    "projectRepositoryLanding": "/api/v1/tenants/:tenant/projects/:project/repositories/landing",
    "drafts": "/api/v1/tenants/:tenant/projects/:project/drafts",
    "draftInitialization": "/api/v1/tenants/:tenant/projects/:project/draft-initializations/:revision",
    "draft": "/api/v1/tenants/:tenant/projects/:project/drafts/:ticket",
    "dispatchView": "/api/v1/tenants/:tenant/projects/:project/dispatch-view",
    "threads": "/api/v1/tenants/:tenant/projects/:project/threads",
    "thread": "/api/v1/tenants/:tenant/projects/:project/threads/:session",
    "threadTranscript": "/api/v1/tenants/:tenant/projects/:project/threads/:session/transcript",
    "threadMessages": "/api/v1/tenants/:tenant/projects/:project/threads/:session/messages",
    "threadClose": "/api/v1/tenants/:tenant/projects/:project/threads/:session/close",
    "threadRename": "/api/v1/tenants/:tenant/projects/:project/threads/:session/rename",
    "threadHide": "/api/v1/tenants/:tenant/projects/:project/threads/:session/hide"
  },
  "schemas": {
    "publicMutation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "RevokeTicket"
            },
            "ticket": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mutation", "ticket"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "ResumeTicket"
            },
            "ticket": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mutation", "ticket"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "ReleaseDraft"
            },
            "ticket": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "authoringVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "configurationRevision": {
              "type": "string"
            }
          },
          "required": [
            "mutation",
            "ticket",
            "authoringVersion",
            "configurationRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "ResolveNativeAction"
            },
            "action": {
              "type": "string"
            },
            "authorizingSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "resolution": {
              "type": "string",
              "enum": [
                "Resume",
                "Revoke",
                "RetryHandoff",
                "AbandonHandoff",
                "Approve",
                "Decline"
              ]
            }
          },
          "required": [
            "mutation",
            "action",
            "authorizingSequence",
            "resolution"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "ManualDispatch"
            },
            "ticket": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "expectedTicketVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mutation", "ticket", "expectedTicketVersion"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mutation": {
              "type": "string",
              "const": "ProposeDispatch"
            },
            "ticket": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "expectedTicketVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observedViewToken": {
              "type": "object",
              "properties": {
                "tenant": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "recoveryEpoch": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "watermark": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "tenant",
                "project",
                "recoveryEpoch",
                "schemaVersion",
                "watermark",
                "digest"
              ],
              "additionalProperties": false
            },
            "selectorDecisionReference": {
              "type": "string"
            }
          },
          "required": [
            "mutation",
            "ticket",
            "expectedTicketVersion",
            "observedViewToken",
            "selectorDecisionReference"
          ],
          "additionalProperties": false
        }
      ]
    },
    "configurationCreation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["revision", "canonical"],
      "additionalProperties": false
    },
    "repositoryConfigurationImport": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["repository", "commit"],
      "additionalProperties": false
    },
    "draftCreation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "configurationRevision": {
          "type": "string",
          "minLength": 1
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedProjectSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authoring": {
          "type": "object",
          "properties": {
            "dependencies": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "program": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fanout": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "combinator": {
                    "type": "string",
                    "enum": ["UnanimousPass", "AnyPass"]
                  }
                },
                "required": ["fanout", "combinator"],
                "additionalProperties": false
              }
            },
            "workFanout": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "reworkPolicy": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "BudgetedRework"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["type", "value"],
              "additionalProperties": false
            },
            "finalizationPricing": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "DeadlineOnly"
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "Budgeted"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["type", "value"],
                  "additionalProperties": false
                }
              ]
            },
            "resumePricing": {
              "type": "string",
              "enum": ["RetryCharged", "RetryFree"]
            },
            "finalizer": {
              "type": "string",
              "enum": ["NoFinalizer", "ManagedFinalizer"]
            }
          },
          "required": [
            "dependencies",
            "program",
            "workFanout",
            "reworkPolicy",
            "finalizationPricing",
            "resumePricing",
            "finalizer"
          ],
          "additionalProperties": false
        },
        "brief": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "links": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^https:\\/\\/.*"
              }
            },
            "checks": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "branch": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^refs\\/heads\\/.*"
            },
            "finalization": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "Push"
                    },
                    "target": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^refs\\/heads\\/.*"
                    }
                  },
                  "required": ["mode"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "PullRequest"
                    },
                    "target": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^refs\\/heads\\/.*"
                    }
                  },
                  "required": ["mode", "target"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["intent", "links"],
          "additionalProperties": false
        }
      },
      "required": [
        "configurationRevision",
        "configurationDigest",
        "expectedProjectSequence",
        "authoring",
        "brief"
      ],
      "additionalProperties": false
    },
