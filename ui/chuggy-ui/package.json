{
  "name": "chuggy-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.terminal.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && vite build --config vite.terminal.config.ts && node ../../scripts/check-console-policy.ts dist && node terminal/built.ts dist",
    "format": "../../node_modules/.bin/prettier --check --log-level warn --ignore-path ../../.gitignore --ignore-path ../../.prettierignore ."
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-router": "^1.170.32",
    "codemirror": "^6.0.2",
    "highlight.js": "~11.11.1",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
