## The words a figure is read with: why one is absent, what a cost is, and
## the units a quantity is counted in.

figures-absent-instant = No instant
figures-absent-run = No { -run } figures yet
figures-absent-cost = No cost measured
figures-absent-tokens = No tokens measured
figures-absent-duration = No duration measured
figures-absent-revision = No earlier { -revision } read
figures-absent-waiting = Waiting
figures-basis-list = list
figures-basis-mixed = mixed
figures-basis-title = List price, not a bill
figures-tokens = tok
figures-ago = { $elapsed } ago
figures-since = { $happened } { $elapsed } ago
figures-happened-started = Started
figures-happened-prepared = Prepared

## The units a quantity somebody set is counted in.

figures-unit-percent = %
figures-unit-hours = h
figures-unit-minutes = min
figures-unit-seconds = s
figures-unit-milliseconds = ms
figures-unit-mebibytes = MiB
figures-unit-kibibytes = KiB
figures-unit-bytes = bytes
figures-unit-tokens = tokens
figures-unit-calls = calls
figures-unit-tickets = { -ticket(form: "plural") }
figures-unit-pages = pages
figures-unit-changes = { $count ->
    [one] change
   *[other] changes
}
