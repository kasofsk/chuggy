      "states": 13,
      "pins": [
        "decideOpRetry",
        "RWorking"
      ],
      "rationale": "the operator resume off the work-failed wall — decideOpRetry's RWorking arm, which no other fixture takes and which a decider roster cannot ask for"
    }
