      "seed": "0x2a",
      "maxSamples": 500,
      "maxSteps": 30,
      "invariant": "not(and { lastStep.label == \"operator-retry\", lastStep.transitions.foldl(false, (b, t) => b or t.to == PWorking) })",
      "expect": "violation",
