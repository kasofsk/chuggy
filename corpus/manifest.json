{
  "tier1": [
    {
      "name": "budgeted-cascade-park",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 500,
      "maxSteps": 30,
      "invariant": "cascadeParkNever",
      "expect": "violation",
      "pins": [
        "decideRevoke",
        "ticket-revoked",
        "task-done-duplicate",
        "operator-retry, RPending flavor"
      ],
      "rationale": "the atomic revoke cascade, the pre-work park and its free resume, and a duplicate task completion",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
      },
      "states": 15
    },
    {
      "name": "budgeted-dequeue-to-gate",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 20000,
      "maxSteps": 60,
      "invariant": "lastStep.label != \"wrapup-started\"",
      "expect": "violation",
      "pins": [
        "decideWrapUpStart",
        "wrapup-started",
        "eval-passed"
      ],
      "rationale": "the dequeue's moved arm — the depth-1 gate opening — and the enqueue that precedes it",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
