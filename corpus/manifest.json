    {
      "name": "budgeted-desk-only-revoke",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 20000,
      "maxSteps": 60,
      "invariant": "not(and { lastStep.label == \"ticket-revoked\", lastStep.transitions.foldl(true, (b, t) => b and t.from == PEscalated) })",
