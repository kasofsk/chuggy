{
  "tier1": [
    {
      "name": "budgeted-cascade-park",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 500,
      "maxSteps": 30,
      "invariant": "cascadeParkNever",
      "expect": "violation",
      "covers": "the atomic revoke cascade, the pre-work park and its free resume, and a duplicate task completion",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
      }
    },
    {
      "name": "budgeted-dequeue-to-gate",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 20000,
      "maxSteps": 60,
      "invariant": "lastStep.label != \"wrapup-started\"",
      "expect": "violation",
      "covers": "the dequeue's moved arm \u2014 the depth-1 gate opening \u2014 and the enqueue that precedes it",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
      }
    },
    {
      "name": "budgeted-landing-duplicate",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 20000,
      "maxSteps": 60,
      "invariant": "lastStep.label != \"complete-duplicate\"",
      "expect": "violation",
      "covers": "a re-delivered landing absorbed by an already-Done ticket",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
      }
    },
    {
      "name": "budgeted-gated-completion",
      "instance": "budgeted",
      "seed": "0x2a",
      "maxSamples": 20000,
      "maxSteps": 60,
      "invariant": "not(and { lastStep.label == \"ticket-done\", lastStep.transitions.length() > 0, lastStep.transitions[0].from == PWrapUpHolding })",
      "expect": "violation",
      "covers": "the gated resolution completing out of the held slot",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
      }
    },
    {
      "name": "budgeted-eval-stage-advance",
      "instance": "budgeted",
      "seed": "0x1",
      "maxSamples": 2000,
      "maxSteps": 40,
      "invariant": "lastStep.label != \"eval-stage-passed\"",
      "expect": "violation",
      "covers": "the eval interpreter advancing a staged program",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
