      "covers": "a failed work cycle escalating straight to the desk",
      "consts": {
        "N_TICKETS": "3",
        "N_TASKS": "2",
        "REWORK_POLICY": "RWBudget(1)",
        "GAS": "3",
        "WRAPUP_PRICING": "Budgeted(1)",
        "OP_RETRY_PRICING": "RetryCharged",
        "MAX_STAGES": "2",
        "N_PROJECTS": "2"
