#!/bin/sh
# Fast gates at the commit, so a violation costs seconds instead of a rework.
#
# Installed with: git config core.hooksPath .githooks   (once per clone)
#
# THE INVARIANT THAT GOVERNS THIS FILE: the hook may reject only what
# `.chug/tasks/ci.sh` runs unconditionally. That is what guarantees it can
# never block a commit the full check would accept — a hook that is stricter
# than CI is a hook people disable, and then none of it runs.
#
# It calls the gate scripts directly rather than going through `just`, because
# `just` may not be installed and a hook that depends on it fails open.
#
# The shell suites are deliberately absent — they are the slowest stage and
# they belong in `just check`.
#
# `git commit --no-verify` bypasses this, and bypasses every gate at once
# rather than the one that was in the way. Legitimate when the alternative is
# leaving work uncommitted; run `just check` before pushing either way.
set -eu
export LC_ALL=C

# A hook inherits these from the invoking git, and they break any command that
# needs to resolve the repo for itself.
unset GIT_DIR GIT_WORK_TREE

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$root" ]; then
	echo "pre-commit: not a git checkout — skipping" >&2
	exit 0
fi
cd "$root" || exit 0

# Mid-operation commits are not the author's edit, and gating them blocks a
# conflict resolution the author cannot change.
for marker in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
	if [ -e "$(git rev-parse --git-path "$marker")" ]; then
		echo "pre-commit: ${marker} present — skipping"
		exit 0
	fi
done

started="$(date +%s)"
rejected=0

run_gate() { # <label> <script> [<arg>...]
	label="$1"
	script="$2"
	shift 2
	[ -x "$script" ] || return 0
	set +e
	out="$("$script" "$@" 2>&1)"
	rc=$?
	set -e
	case "$rc" in
	0) ;;
	1)
		printf '%s\n' "$out"
		echo "pre-commit: REJECTED by $label"
		rejected=$((rejected + 1))
		;;
	*)
		# Could not run is a loud skip here, not a rejection: the full check
		# treats it as a failure, and this hook must not be the stricter of
		# the two.
		printf '%s\n' "$out"
		echo "pre-commit: $label could not run (rc=$rc) — not blocking; \`just check\` will"
		;;
	esac
}

run_gate "doc-lint" ./.chug/tasks/doc-lint.sh
run_gate "check-figures" ./.chug/tasks/check-figures.sh
run_gate "check-shell-quoting" ./.chug/tasks/check-shell-quoting.sh
run_gate "check-gates" ./.chug/tasks/check-gates.sh

# check-paths is whole-tree in `just check` and staged-only here. It resolves
# against the whole tracked set either way, so the narrowing changes what is
# scanned and not what counts as a claim — which keeps this the weaker of the
# two runs, never the stricter one.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "$staged" ]; then
	set -f
	IFS='
'
	set -- $staged
	unset IFS
	set +f
	run_gate "check-paths" ./.chug/tasks/check-paths.sh "$@"
fi

elapsed=$(( $(date +%s) - started ))
if [ "$rejected" -gt 0 ]; then
	echo "pre-commit: ${rejected} gate(s) rejected this commit (${elapsed}s)"
	exit 1
fi
echo "pre-commit: clean (${elapsed}s)"
