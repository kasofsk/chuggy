{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "work", "evaluation", "finalization"],
  "properties": {
    "version": { "const": 2 },
    "title": { "type": "string" },
    "instructions": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    },
    "work": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
    "evaluation": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
    "finalization": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
    "inputs": { "type": "object" },
    "rework_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
