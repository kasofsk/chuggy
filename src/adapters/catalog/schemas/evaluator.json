{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "workload"],
  "properties": {
    "kind": {"const": "evaluator"},
    "name": {"type": "string", "minLength": 1},
    "workload": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}
  }
}
