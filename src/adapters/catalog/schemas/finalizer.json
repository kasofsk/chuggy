{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "target_ref", "branch_prefix"],
      "properties": {
        "kind": { "const": "finalizer" },
        "operation": { "const": "pull-request" },
        "target_ref": { "type": "string", "minLength": 1 },
        "branch_prefix": { "type": "string", "minLength": 1 },
        "merge": { "type": "boolean", "default": false }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "target_ref"],
      "properties": {
        "kind": { "const": "finalizer" },
        "operation": { "const": "git-merge" },
        "target_ref": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation"],
      "properties": {
        "kind": { "const": "finalizer" },
        "operation": { "const": "no-op" }
      }
    }
  ]
}
