{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "stages"],
  "properties": {
    "kind": {"const": "evaluation-plan"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evaluators"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "evaluators": {
            "type": "array",
            "minItems": 1,
            "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}
          }
        }
      }
    }
  }
}
